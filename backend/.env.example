# Habit Tracker Environment Variables Example
JWT_SECRET_KEY=your_jwt_secret_key_here
VAPID_CLAIMS_EMAIL=mailto:habit-tracker-alerts@example.com
DATA_FILE_PATH=./data_store.json

# Neon Serverless Postgres Connection String Placeholder (Async Driver)
# Example: postgresql+asyncpg://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://your_user:your_password@ep-your-instance.aws.neon.tech/neondb?sslmode=require

# Resend Email Configuration
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=your_email@example.com

# Deployment URL settings
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS_CSV=http://localhost:5173,http://localhost:3000

# Shared secret key for triggering scheduled reminders (Required for Render deployment)
DISPATCH_SECRET=your_dispatch_secret_key_here
